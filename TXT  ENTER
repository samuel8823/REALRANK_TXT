const { Client, GatewayIntentBits } = require('discord.js');

const client = new Client({
    intents: [
        GatewayIntentBits.Guilds,
        GatewayIntentBits.GuildMembers
    ]
});

const TOKEN = 'PON_AQUI_EL_TOKEN_DE_TU_BOT';
const ROLE_ID = 'PON_AQUI_EL_ID_DEL_ROL';

client.once('ready', () => {
    console.log(`Bot conectado como ${client.user.tag}`);
});

client.on('guildMemberAdd', async (member) => {
    try {
        const role = member.guild.roles.cache.get(ROLE_ID);

        if (!role) {
            console.log(`No encontré el rol ${ROLE_ID}`);
            return;
        }

        await member.roles.add(role);

        console.log(`✅ ${member.user.tag} recibió el rol ${role.name}`);
    } catch (error) {
        console.error('❌ No pude asignar el rol:', error);
    }
});

client.login(TOKEN);
